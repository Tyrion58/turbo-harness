# Copy to `.env` and fill in. Never commit real secrets.

# --- Vertex AI (frontier model calls via anthropic[vertex] / litellm) ---
VERTEXAI_PROJECT=your-gcp-project
VERTEXAI_LOCATION=us-east5

# --- Frontier model for Meta-Harness proposals + ACE playbook curation ---
TURBO_FRONTIER_MODEL=vertex_ai/claude-sonnet-4-5

# --- SWE coding servers (agent execution + patch scoring) ---
AGENT_SERVER_URL=http://localhost:8081
EVAL_SERVER_URL=http://localhost:5152

# --- Storage roots (default to repo-relative dirs; override for large NVMe/scratch) ---
TURBO_ARTIFACTS_DIR=./artifacts
TURBO_DATA_DIR=./data
TURBO_ADVISOR_CKPT_DIR=./checkpoints
TURBO_ADVISOR_EXPORT_DIR=./exports

# --- Hugging Face cache (model weights) ---
# HF_HOME=/path/to/hf-cache

# --- Weights & Biases: run `wandb login` once; do NOT commit a key here ---
# WANDB_API_KEY=

# --- Terminal-Bench-2.1 (harbor engine); set ONE of these (see docs/DEPENDENCIES.md) ---
# TB2_ENGINE_DIR=/path/to/terminal_bench_2
# HARBOR_BIN=/path/to/harbor
